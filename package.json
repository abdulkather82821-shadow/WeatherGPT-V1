{
  "name": "weathergpt",
  "version": "1.0.0",
  "private": true,
  "description": "Android-ready WeatherGPT application",
  "scripts": {
    "build:web": "node scripts/build.mjs",
    "android:add": "npm run build:web && cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "start": "node scripts/server.mjs",
    "check": "node --check app.js"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
